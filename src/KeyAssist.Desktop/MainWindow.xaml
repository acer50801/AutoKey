<Window x:Class="KeyAssist.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="按鍵輔助 v8" Width="1120" Height="820" MinWidth="550" MinHeight="450"
        Background="#F1F5F8" Foreground="#19283B" FontSize="14"
        FontFamily="Segoe UI, Microsoft JhengHei" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
    </Window.Resources>
    <DockPanel Background="#F1F5F8">
        <Border DockPanel.Dock="Top" Background="#182C40" Padding="18,12">
            <DockPanel>
                <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="儲存設定" Margin="10,0,0,0" IsEnabled="False"/>
                <StackPanel>
                    <TextBlock Text="按鍵輔助 · v8" Foreground="White" FontWeight="SemiBold" FontSize="21"/>
                    <TextBlock Text="設定檢查與離線詞綴比對" Foreground="#C5D7E6" FontSize="13"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#DFE9F2" Padding="16,7">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="#22394E" Padding="9,15">
                <StackPanel x:Name="Navigation"/>
            </Border>
            <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PageContent" Margin="18,14,18,18"/>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
